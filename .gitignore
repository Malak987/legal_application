# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Local Supabase compile-time values (public client key only)
/supabase.local.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle / AGP build output. `android/build/**` must never be committed: it is
# regenerated on every build and only bloats the repository.
/android/build/
/android/.gradle/
/android/local.properties
/android/captures/

# Android release signing material — never commit keystores or passwords.
/android/key.properties
*.jks
*.keystore

# iOS signing material — never commit certificates or provisioning profiles.
*.p8
*.p12
*.mobileprovision
/ios/Flutter/Generated.xcconfig
/ios/Runner/GoogleService-Info.plist

# Desktop / web build output
/Flutter/ephemeral/
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/

# Widget Preview related
.widget_preview/
